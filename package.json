{
  "name": "mindmosaic",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e:build": "detox build --configuration android.emu.release",
    "e2e:test": "detox test --configuration android.emu.release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/bottom-tabs": "^6.6.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@expo/vector-icons": "^14.0.0",
    "expo": "~51.0.10",
    "expo-application": "~6.1.1",
    "expo-asset": "~11.0.2",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "expo-localization": "~16.0.0",
    "expo-notifications": "~0.28.11",
    "expo-speech": "~12.0.0",
    "expo-system-ui": "~4.0.3",
    "i18next": "^23.10.1",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-i18next": "^13.5.0",
    "react-native": "0.74.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-pdf": "^6.9.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "14.1.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-typescript": "^7.24.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.1",
    "@types/jest": "^29.5.12",
    "@types/react": "18.2.46",
    "@types/react-native": "0.74.1",
    "@types/react-native-pdf": "^6.5.4",
    "@types/react-native-svg": "^13.13.2",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.14.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.3",
    "metro": "^0.80.8",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "moduleNameMapper": {
      "^@/(.*)": "<rootDir>/app/$1"
    }
  },
  "detox": {
    "test-runner": "jest",
    "runner-config": "./tests/e2e/jest.detox.config.js",
    "configurations": {
      "android.emu.release": {
        "device": {
          "avdName": "Pixel_5_API_34"
        },
        "app": {
          "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
          "build": "expo prebuild --platform android && cd android && ./gradlew assembleRelease && cd .."
        }
      }
    }
  }
}
